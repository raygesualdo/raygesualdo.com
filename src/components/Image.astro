---
import type { ImageMetadata, ImageTransform } from 'astro'
import { Picture } from 'astro:assets'
import LoadableImage from './LoadableImage.astro'

type Props = {
  src: ImageMetadata
  alt: string
  placeholder?: 'blur' | 'empty'
} & Omit<ImageTransform, 'src'> &
  Omit<astroHTML.JSX.ImgHTMLAttributes, 'src' | 'width' | 'height'>

const {
  src,
  alt,
  loading = 'lazy',
  decoding = 'async',
  placeholder: placeholderType,
  ...rest
} = Astro.props

if (!src) {
  throw new Error('src is required')
}
---

{
  placeholderType === 'blur' ? (
    <LoadableImage src={src} alt={alt} loading={loading} decoding={decoding} {...rest} />
  ) : (
    <Picture src={src} alt={alt} loading={loading} decoding={decoding} {...rest} />
  )
}
