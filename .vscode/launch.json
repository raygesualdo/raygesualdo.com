{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Server (Astro)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal"
    },
    {
      "name": "Debug Client (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:4321",
      "webRoot": "${workspaceFolder}"
    }
  ],
  "compounds": [
    {
      "name": "Debug Full Astro App",
      "configurations": ["Debug Server (Astro)", "Debug Client (Chrome)"]
    }
  ]
}
